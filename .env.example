# Modelo razonador (RAG + decisión de escalamiento) — familia permitida por el reto
GEMINI_API_KEY=

# Voz (STT/TTS o Conversational AI) — no restringido por el reto
ELEVENLABS_API_KEY=
# ID del agente creado en la consola de ElevenLabs (Agents)
ELEVENLABS_AGENT_ID=

# Respaldo automático del modelo razonador (familia Llama, también permitida)
GROQ_API_KEY=

# Interruptor de seguridad: agente model-driven en LangGraph (true, default) vs.
# el pipeline fijo original (false) — ver docs/arquitectura/agentic-rag.md
AGENTIC_RAG_ENABLED=true

# Pausas prosódicas en la voz (<break time="0.3s"/> justo antes de cada pregunta).
# Solo las entiende la familia v2 de ElevenLabs; en false se eliminan del stream
# antes de llegar al TTS. Interruptor de emergencia: no hace falta tocarlo.
VOICE_PAUSES_ENABLED=true

# Trazas de MLflow (una por turno). Requiere levantar aparte el visor — ver la
# sección de observabilidad del README. Si no está corriendo, el agente funciona
# igual, solo sin trazas.
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5605
