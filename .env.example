# Modelo razonador (RAG + decisión de escalamiento) — familia permitida por el reto
GEMINI_API_KEY=

# Voz (STT/TTS o Conversational AI) — no restringido por el reto
ELEVENLABS_API_KEY=
# ID del agente creado en la consola de ElevenLabs (Agents)
ELEVENLABS_AGENT_ID=

# Opcional: no se usa como modelo razonador (GPT no está en la lista de familias
# permitidas — ver docs/reto/stack-tecnico.md#1-los-modelos-permitidos). Dejar solo
# si se termina necesitando para algo no relacionado con el razonamiento del agente.
OPENAI_API_KEY=
